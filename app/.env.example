# DailyReels project root. Windows example:
# DAILYREELS_ROOT=G:\내 드라이브\DailyReels
# Omitted -> the parent folder of app\ is used.

# Optional: explicit binary locations (default: looked up on PATH)
# DAILYREELS_FFPROBE=C:\ffmpeg\bin\ffprobe.exe
# DAILYREELS_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe

# Caption font (v0.5). 지정하지 않으면 Paperlogy -> Malgun Gothic 순으로 자동 탐색한다.
# CAPTION_FONT_FILE=C:\Users\<me>\AppData\Local\Microsoft\Windows\Fonts\Paperlogy-6SemiBold.ttf
# CAPTION_FONT_NAME=Paperlogy

# Optional: alternative config file (default: app\config\dailyreels.toml)
# DAILYREELS_CONFIG=

# API keys go here (v0.2+). Never commit the real .env.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
