# Targeting Agent Credential (실제 .env 파일은 절대 git에 커밋하지 말 것)

# Gemini API Key — analysis.provider=gemini 일 때만 필요.
# 없으면 analysis.fallback_to_heuristic 설정에 따라 규칙 기반 분석으로 동작한다.
GEMINI_API_KEY=

# Instagram Graph API (OfficialAPIExecutor / hashtag discovery 사용 시)
# 계정 ID/Password는 어떤 경우에도 여기에 저장하지 않는다. Access Token만 사용한다.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
