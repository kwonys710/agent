# Google OAuth Desktop App credentials (실제 파일은 절대 git에 커밋하지 말 것)
GOOGLE_OAUTH_CLIENT_SECRET_FILE=./credentials/client_secret.json
GOOGLE_OAUTH_TOKEN_DIR=./data/.tokens

# 프로젝트별 root_folder_id를 config.yaml 대신 환경변수로 넘기고 싶을 때 사용
# 규칙: PM_<PROJECT_ID 대문자>_ROOT_FOLDER_ID
# PM_JUNGSOO_ROOT_FOLDER_ID=your_folder_id_here
